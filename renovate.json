{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "nix": {
    "enabled": false
  },
  "ignoreUnstable": true,
  "packageRules": [
    {
      "description": "Never upgrade to unstable pre-releases, release candidates (RC), beta, or alpha",
      "matchDatasources": ["docker"],
      "ignoreUnstable": true
    },
    {
      "description": "Pin digests for floating/moving tags so updates are tracked in GitOps",
      "matchDatasources": ["docker"],
      "matchCurrentValue": "/^(latest|alpine|main|master)$/",
      "pinDigests": true
    },
    {
      "description": "Keep Immich services synchronized on identical releases",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/immich-app/**"],
      "groupName": "immich"
    },
    {
      "description": "Keep Authentik server, worker, and ldap synchronized on identical releases",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/goauthentik/**"],
      "groupName": "authentik"
    }
  ],
  "customManagers": [
    {
      "description": "Match versioned OCI containers while strictly preserving tag prefixes, compatibility suffixes/flavors, and locking out pre-releases",
      "customType": "regex",
      "fileMatch": ["\\.nix$"],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^\"@:]+):(?<currentValue>(?:(?<tagPrefix>[a-zA-Z_-]+))?v?[0-9]+(?:\\.[0-9]+)+(?:-(?<compatibility>[a-zA-Z0-9_.]+))?)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\";"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?:(?<tagPrefix>[a-zA-Z_-]+))?v?(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?(?:-(?<prerelease>(?:alpha|beta|rc|dev|preview)[a-zA-Z0-9_.]*))?(?:-(?<compatibility>[a-zA-Z0-9_.]+))?$"
    },
    {
      "description": "Match moving/floating tags pinned by digest without altering the tag itself",
      "customType": "regex",
      "fileMatch": ["\\.nix$"],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^\"@:]+):(?<currentValue>latest|alpine|main)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\";"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
